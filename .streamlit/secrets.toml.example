# Copy these lines into Streamlit Cloud → your app → ⋮ → Settings → Secrets
# (or, on your own computer, into .streamlit/secrets.toml). Never commit real values to GitHub.

[users.navneet]
name = "Navneet"
role = "admin"
password = "choose-a-strong-password"

# More accounts: copy the block, change the ID after "users.", use role = "user"
# [users.ravi]
# name = "Ravi"
# role = "user"
# password = "another-strong-password"

[dhan]
client_id = "your Dhan client ID"
access_token = "your Dhan access token (expires every 24 hours)"

# Keeps accounts, passwords changed in the app, preferences and watchlists across Streamlit Cloud restarts
# (cloudstore.py). Create the table with supabase/schema.sql, then copy Project Settings -> API Keys -> the
# SECRET key (sb_secret_..., or the legacy service_role key). Never use the publishable/anon key here.
[supabase]
url = "https://your-project-ref.supabase.co"
key = "sb_secret_..."

# Fallback prices for forex, INR pairs and gold when Yahoo fails (free plan: 800 credits a day)
[twelvedata]
api_key = "your Twelve Data key"
