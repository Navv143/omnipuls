# HTTPS for the Omnipuls cloud server. Caddy gets and renews a free Let's Encrypt certificate for $DOMAIN by itself.
# the server's DOMAIN (deploy/.env) and omnipuls.cloud, both served (the old address keeps working)
{$DOMAIN}, omnipuls.cloud {
	encode zstd gzip
	# live ticks: the browser's secure WebSocket (wss://DOMAIN/ticks) goes to the app's tick relay
	handle /ticks* {
		reverse_proxy app:8765
	}
	# phone home-screen icons at the site root (iPhones look here), served by Streamlit from ./static
	handle /apple-touch-icon* {
		rewrite * /app/static{path}
		reverse_proxy app:8501
	}
	# search engines: robots.txt and sitemap.xml, served by Streamlit from ./static
	handle /robots.txt {
		rewrite * /app/static/robots.txt
		reverse_proxy app:8501
	}
	handle /sitemap.xml {
		rewrite * /app/static/sitemap.xml
		reverse_proxy app:8501
	}
	# everything else: the Streamlit app (its own WebSocket included)
	handle {
		reverse_proxy app:8501
	}
}

# www.omnipuls.cloud -> omnipuls.cloud (the www record is a CNAME to the main domain)
www.omnipuls.cloud {
	redir https://omnipuls.cloud{uri} permanent
}
