# HTTPS for the Omnipuls cloud server. Caddy gets and renews a free Let's Encrypt certificate for $DOMAIN by itself.
{$DOMAIN} {
	encode gzip
	# live ticks: the browser's secure WebSocket (wss://DOMAIN/ticks) goes to the app's tick relay
	handle /ticks* {
		reverse_proxy app:8765
	}
	# phone home-screen icons at the site root (iPhones look here), served by Streamlit from ./static
	handle /apple-touch-icon* {
		rewrite * /app/static{path}
		reverse_proxy app:8501
	}
	# everything else: the Streamlit app (its own WebSocket included)
	handle {
		reverse_proxy app:8501
	}
}

# www.<domain> -> <domain> (needs a www record pointing here; Hostinger adds it as a CNAME to the main domain)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
